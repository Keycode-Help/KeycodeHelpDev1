# Supabase Configuration for KCH Frontend
# Copy this file to .env.local and fill in your Supabase credentials

# Supabase Project URL (from your Supabase project settings)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Key (from your Supabase project settings > API)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: Backend URL (if you still need some Java backend endpoints)
VITE_BACKEND_URL=http://localhost:8080

# Development settings
VITE_NODE_ENV=development

# Optional: Enable debug logging
VITE_DEBUG_API=false
